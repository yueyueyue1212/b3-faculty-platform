# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Secrets and local environment (never commit real keys)
.env
.env.*
!.env.example

# Local databases and SQLite sidecar files
backend/data/*.db
backend/data/*.db-*
*.sqlite3

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# Intermediate PyInstaller output
release/_build/
release/_work/

# Source snapshots and portable build artifacts
# (git is the primary version history; rebuild releases from source)
backups/
release/B3-Portable/
release/B3-Portable.zip
release/B3-Portable.zip.sha256

# Logs, coverage and editor/OS files
*.log
logs/
backend/logs/
.coverage
htmlcov/
.DS_Store
Thumbs.db
.vscode/
.idea/
