# ===== 数据库 =====
# 默认使用 SQLite（backend/data/app.db）。可改为 MySQL/PostgreSQL 连接串。
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/b3_platform?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/b3_platform

# 开发密钥：部署时务必替换为随机长字符串
SECRET_KEY=please-change-this-development-secret
TOKEN_EXPIRE_MINUTES=720

# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 首次启动且数据库为空时自动生成演示数据（true/false）
AUTO_SEED_ON_STARTUP=true

# 上传限制（字节）与类型
MAX_UPLOAD_BYTES=5242880

# ===== LLM（可选） =====
# 未配置 LLM_API_KEY 时，系统自动使用本地规则摘要，所有业务功能仍可用。
# 兼容 OpenAI Chat Completions 协议的任一服务商。
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20
LLM_RETRIES=2
# 默认不发送任何教师姓名/联系方式；仅发送统计事实与研究关键词。
LLM_ALLOW_PERSONAL_DATA=false

# ===== Embedding（可选，当前版本默认使用本地 TF-IDF 关键词算法） =====
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
